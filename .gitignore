# OS / editor
.DS_Store
Thumbs.db
*.swp

# Agent governance — personal & captured (never committed)
.claude/settings.local.json
.claude/worktrees/
logs/

# Secrets — never read, never committed
.env
.env.*
secrets/

# Python / uv (toolchain arrives at ramp-up)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
# OSMnx writes its Overpass response cache to ./cache by default, so any real compile
# leaves ~2 MB of hash-named JSON in the repo root. Ignored rather than relocated: it is a
# genuine cache (a re-compile of the same area is then free and offline), and the failure
# it prevents is someone's `git add -A` committing a few megabytes of third-party API
# responses whose licence terms nobody checked for redistribution.
cache/

# Node / web (arrives at M1)
node_modules/
dist/

# Throwaway discovery spike (D5) — never merged
spike/

# Local dev-stack run dir (pids + logs from scripts/dev.sh)
.dev/

# Dev basemap — machine-produced by `scripts/fetch-basemap.sh` from a dated
# Protomaps daily build. Build inputs, not sources: regenerate, never commit.
# DU-05 moves these into the compiled bundle behind TileSourceV1.
# Kept OUT of web/public/ deliberately — vite.config.ts "Footgun 1": public/
# copies verbatim into dist/, and a multi-MB archive must never enter the graph.
web/dev-assets/

# Playwright (T004) — run artifacts, never committed.
/web/test-results/
/web/playwright-report/
/web/blob-report/
